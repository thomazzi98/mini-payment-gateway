{
  "name": "mini-payment-gateway",
  "version": "0.1.0",
  "description": "API-first multi-tenant payment gateway with provider-agnostic Pix support",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Rafael Thomazzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomazzi98/mini-payment-gateway.git"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.11.1 <25.0.0",
    "npm": ">=11.6.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --dry --force && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project domain --project shared --project dashboard --project tools",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --project e2e",
    "demo:up": "node scripts/demo-stack.mjs up",
    "demo:pay": "node scripts/demo-pay.mjs",
    "knip": "knip",
    "docs:generate": "node scripts/verify-docs.mjs --write",
    "docs:check": "node scripts/verify-docs.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "validate:appmax": "node scripts/validate-appmax.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
