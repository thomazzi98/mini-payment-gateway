{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**"]
    },
    "apps/api": {
      "entry": ["src/main.api.ts", "src/infrastructure/persistence/migrate-cli.ts"],
      "project": ["src/**"]
    },
    "packages/shared": {
      "project": ["src/**"]
    }
  },
  "ignoreDependencies": ["@commitlint/cli", "husky", "lint-staged"]
}
