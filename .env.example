# Copy to .env and adjust. .env is gitignored and must never contain a real
# production secret. Generate a random value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development
LOG_LEVEL=info

# Host ports. These defaults were chosen because they are free on this machine;
# 3000, 3001, 3100, 3200 and 8080 are already taken by other projects.
API_HOST_PORT=4010
DASHBOARD_HOST_PORT=4020
PROVIDER_SIMULATOR_HOST_PORT=4030
POSTGRES_HOST_PORT=55433
REDIS_HOST_PORT=63790

# PostgreSQL. The application connects as a least-privileged role; migrations
# run as the owner. Both are created by the compose stack.
POSTGRES_DB=payment_gateway
POSTGRES_USER=payment_gateway_owner
POSTGRES_PASSWORD=change_me_locally

# The application connects as this role, which owns nothing and cannot bypass row
# level security. Keeping it distinct from the owner is what makes tenant isolation
# a property of the database rather than of the code.
DATABASE_APPLICATION_PASSWORD=change_me_locally_too

# Verifying an API key needs this on every request, so the process refuses to
# start without it. It lives outside the database on purpose: a database dump
# alone must not yield a usable key. At least 32 characters.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Changing it invalidates every existing API key, because it changes every hash.
API_KEY_PEPPER=

# The unguessable segment of the provider notification URL, configured with the
# provider as part of the webhook address. Appmax sends no signature of any kind,
# so this bounds who can reach the endpoint. It is not what protects the money: a
# notification can only schedule an authenticated read, and the database refuses
# to fund a payment on anything less. At least 24 characters.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_PATH_SECRET=

# Appmax. NOT YET AVAILABLE — leave empty and the gateway uses the bundled
# provider simulator. Fill these in and run `npm run validate:appmax` to exercise
# the real sandbox; no code change is required.
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=

# Which Appmax the credentials above belong to. A payment in the other environment
# finds no provider and is refused, rather than being served a code from the wrong
# world. Production never silently falls back to sandbox.
APPMAX_ENVIRONMENT=SANDBOX

# A CPF the Appmax sandbox accepts. Required only by `npm run validate:appmax`,
# and only for the step that actually creates an order. Without it the script
# still validates configuration, authentication and connectivity, and reports the
# Pix step as skipped rather than as passed.
APPMAX_VALIDATION_DOCUMENT_NUMBER=
